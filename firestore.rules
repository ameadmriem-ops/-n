rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Movies & series collections: public read, admin update
    match /movies/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // FCM Notification queue: used to trigger Cloud Functions broadcasts
    match /notification_queue/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // FCM Device Tokens: devices register their push tokens
    match /fcm_tokens/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
